# LLM Provider — choose one: "anthropic", "openai", or "gemini"
LLM_PROVIDER=gemini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini (free tier available)
GEMINI_API_KEY=...

# Target app URL (default for Docker setup)
TARGET_APP_URL=http://localhost:5000

# noVNC URL (for human-in-the-loop escalation)
NOVNC_URL=http://localhost:6080

# Safety: max steps for discovery loop
MAX_DISCOVERY_STEPS=25

# Safety: max replay retries per step
MAX_STEP_RETRIES=3
