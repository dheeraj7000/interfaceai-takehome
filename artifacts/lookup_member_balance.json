{
  "metadata": {
    "name": "lookup_member_balance",
    "display_name": "Look Up Member Savings Balance",
    "description": "Navigates to the HFCU BackOffice member search page, searches for a member by ID, and extracts their savings account balance from the member detail page.",
    "version": "1.0.0",
    "schema_version": "1.0",
    "surface_type": "legacy_web",
    "target_url_pattern": "http://localhost:5000/*",
    "source_goal": "Look up member M1001 and read their current savings balance",
    "created_at": "2026-09-08T10:00:00Z",
    "created_by": "discovery_agent",
    "tags": ["member", "balance", "read-only", "savings"],
    "tenant_id": null,
    "parent_artifact_id": null
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "The member ID to look up (e.g. M1001)",
      "sensitive": false,
      "default": null,
      "validation_pattern": "^M\\d{4,}$"
    }
  ],
  "outputs": [
    {
      "name": "member_name",
      "type": "string",
      "description": "The full name of the member",
      "extractor": {
        "strategy": "css_selector",
        "value": "td.dlbl:has-text('Full Name') + td.dval",
        "semantic": "The member full name cell in the Member Information table"
      },
      "sensitive": false
    },
    {
      "name": "savings_balance",
      "type": "string",
      "description": "The member's savings account balance",
      "extractor": {
        "strategy": "xpath",
        "value": "//table[contains(@class,'atbl')]//tr[td[contains(text(),'Savings')]]/td[contains(@class,'bal')]",
        "semantic": "The balance cell in the Savings row of the Accounts table"
      },
      "sensitive": false
    },
    {
      "name": "member_status",
      "type": "string",
      "description": "The account status (Active, Frozen, etc.)",
      "extractor": {
        "strategy": "css_selector",
        "value": "td.dlbl:has-text('Status') + td.dval",
        "semantic": "The status cell in the Member Information table"
      },
      "sensitive": false
    }
  ],
